PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development
OWNER_USERNAME=TYC
# Must contain at least one non-digit character — some hosts (confirmed on
# GoDaddy Airo) silently drop secret values that are purely numeric.
OWNER_PASSCODE=change-me-1969
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional. Without these, league data is stored as JSON files on local
# disk (fine for local dev, risky in production on hosts that wipe disk
# between deploys). Set both to persist to Upstash Redis instead:
# https://upstash.com -> create a free Redis database -> copy the REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
