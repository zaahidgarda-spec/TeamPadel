PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development
OWNER_USERNAME=TYC
# Must contain at least one non-digit character — some hosts (confirmed on
# GoDaddy Airo) silently drop secret values that are purely numeric.
OWNER_PASSCODE=change-me-1969

# Optional. Without these, captains can still turn on email notifications
# in the app, but no email actually sends (logged to the console instead).
# Use a Gmail App Password, not your real Gmail password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional, but you already need these for league data — see below.
# Without them: league data is stored as JSON files on local disk (fine for
# local dev, risky in production on hosts that wipe disk between deploys),
# and logins are stored in server memory (leaks over time, and everyone gets
# logged out on every restart/redeploy). Set both to fix both at once:
# https://upstash.com -> create a free Redis database -> copy the REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, defaults to off. Turns on the Rankings tab, win% predictions,
# and rating tiles/deltas in this deployment's frontend. The backend that
# computes ratings is always on regardless — this only controls whether
# THIS site's UI shows it. Set to "true" (no other change needed) on a
# second deployment of this same codebase that's meant to surface it —
# e.g. a dedicated ratings site sharing the same UPSTASH_REDIS_* database
# as this one, so a claimed player's rating is the same number on both.
RATINGS_ENABLED=false

# Optional. Without these, every "Pay with PayFast" button on the site uses
# PayFast's own public sandbox account — real-looking checkout, but no real
# money ever moves, and no signup is needed for that. To take real payments:
# 1. Sign up for a PayFast merchant account: https://www.payfast.co.za
#    (needs your business/bank details, for payouts).
# 2. In the PayFast dashboard: Settings -> Integration. Merchant ID and
#    Merchant Key are shown there; set a security Passphrase on the same
#    page (recommended, not required by PayFast itself).
# 3. Set all three below, AND set PAYFAST_SANDBOX=false — both are required
#    together. Real credentials with sandbox mode left on (or unset) still
#    safely uses the sandbox; this app never goes live on a half-configured
#    environment.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# James, the admin assistant in the Note Machine (optional). Without a key he
# shows "not connected" and nothing else changes. Create a key at
# console.anthropic.com, and set a monthly limit there too.
# On GoDaddy Airo: add ANTHROPIC_API_KEY under Secrets (Preview, then Live).
ANTHROPIC_API_KEY=
# Optional. Defaults: claude-sonnet-5-5, $25 a month, 100 requests a day each.
# JAMES_MODEL=claude-sonnet-5-5
# JAMES_MONTHLY_CAP_USD=25
# JAMES_DAILY_LIMIT=100
# JAMES_DAILY_CHANGES=60     (most changes James can make for one admin in a day)

# Leo, the picture maker for James (optional): OpenAI draws logos and kit designs from a brief
# James writes and you check first. Needs an OpenAI API account with billing, and OpenAI
# may ask you to verify your organisation before it allows image models.
# On GoDaddy Airo: add OPENAI_API_KEY under Secrets (Preview, then Live).
OPENAI_API_KEY=
# Optional. Defaults: gpt-image-2.5-flare for new pictures, gpt-image-2.5-sunburst when
# starting from your own photo; $15 a month; 20 pictures a day each.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
# JAMES_IMAGE_CAP_USD=15
# JAMES_DAILY_IMAGES=20
