PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development
OWNER_USERNAME=TYC
# Must contain at least one non-digit character — some hosts (confirmed on
# GoDaddy Airo) silently drop secret values that are purely numeric.
OWNER_PASSCODE=change-me-1969

# Optional. Without these, captains can still turn on email notifications
# in the app, but no email actually sends (logged to the console instead).
# Use a Gmail App Password, not your real Gmail password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional, but you already need these for league data — see below.
# Without them: league data is stored as JSON files on local disk (fine for
# local dev, risky in production on hosts that wipe disk between deploys),
# and logins are stored in server memory (leaks over time, and everyone gets
# logged out on every restart/redeploy). Set both to fix both at once:
# https://upstash.com -> create a free Redis database -> copy the REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, defaults to off. Turns on the Rankings tab, win% predictions,
# and rating tiles/deltas in this deployment's frontend. The backend that
# computes ratings is always on regardless — this only controls whether
# THIS site's UI shows it. Set to "true" (no other change needed) on a
# second deployment of this same codebase that's meant to surface it —
# e.g. a dedicated ratings site sharing the same UPSTASH_REDIS_* database
# as this one, so a claimed player's rating is the same number on both.
RATINGS_ENABLED=false
